{
  "name": "nl2sql-ai-assistant",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently --kill-others --success all --names BACKEND,FRONTEND --prefix-colors blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "start": "npm run dev",
    "dev:backend": "cd backend && .venv\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8001",
    "dev:frontend": "npm --prefix frontend run dev"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
